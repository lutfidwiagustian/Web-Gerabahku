<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Gerabah Sendang – Kasongan, Bantul</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700&family=Literata:opsz,wght@7..72,400;7..72,600&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#E4E2DC;--surface:#F2F1ED;--ink:#25211E;--muted:#5B5650;--glaze:#2F5D4C;--on-glaze:#fff;
  --clay:#B5623F;--smoke:#3B3633;--celadon:#9DB8A6;--ash:#D6D2C7;--iron:#6E4B3A;
  --k:7px;
  --head:"Bricolage Grotesque","Helvetica Neue",Arial,sans-serif;--body:Literata,Georgia,serif;
  box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --bg:#1C1A18;--surface:#262321;--ink:#ECE9E2;--muted:#A8A299;--glaze:#8DB8A5;--on-glaze:#14201a;--smoke:#4a4440;
}}
:root[data-theme="dark"]{--bg:#1C1A18;--surface:#262321;--ink:#ECE9E2;--muted:#A8A299;--glaze:#8DB8A5;--on-glaze:#14201a;--smoke:#4a4440}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:400 1.0625rem/1.65 var(--body)}
h1,h2,h3{font-family:var(--head);line-height:1.05;margin:0;letter-spacing:-.02em}
button{font:inherit;color:inherit;cursor:pointer}
:focus-visible{outline:3px solid var(--glaze);outline-offset:3px}
.wrap{max-width:1180px;margin:0 auto;padding:0 clamp(1rem,4vw,2.5rem)}
header{display:flex;justify-content:space-between;align-items:center;padding:1.25rem 0}
.brand{font:700 1.25rem var(--head);letter-spacing:-.02em}
.cartbtn{background:none;border:2px solid var(--ink);padding:.45rem 1rem;font:500 1rem var(--head)}
.cartbtn b{display:inline-block;min-width:1.4em;margin-left:.4rem;background:var(--ink);color:var(--bg);text-align:center}
.intro{padding:clamp(2rem,6vw,4.5rem) 0 1.5rem;max-width:46rem}
h1{font-size:clamp(2.4rem,7vw,4.8rem);font-weight:700}
.intro p{max-width:34rem;color:var(--muted);margin:1.25rem 0 0}
.filters{display:flex;flex-wrap:wrap;gap:.5rem;margin:1.5rem 0 0}
.chip{background:none;border:2px solid var(--ink);padding:.25rem .9rem;font:500 .95rem var(--head)}
.chip[aria-pressed=true]{background:var(--ink);color:var(--bg)}
.shelfnote{color:var(--muted);font-size:.9rem;margin:2.5rem 0 .5rem}
.shelfscroll{overflow-x:auto;padding-bottom:.5rem}
.shelf{display:flex;align-items:flex-end;gap:clamp(1rem,3vw,2.5rem);min-width:max-content;padding:0 1rem;border-bottom:6px solid var(--ink);min-height:120px}
.slot{background:none;border:0;padding:0 0 1rem;display:flex;flex-direction:column;align-items:center;gap:.6rem;position:relative}
.slot svg{display:block;width:calc(var(--w)*var(--k));height:calc(var(--h)*var(--k));overflow:visible;transform-origin:bottom;animation:rise .7s cubic-bezier(.2,.7,.2,1) both;animation-delay:calc(var(--i)*90ms)}
.slot span{font:500 .9rem var(--head);max-width:8rem;text-align:center;line-height:1.2}
.slot[aria-pressed=true] span{text-decoration:underline;text-decoration-thickness:3px;text-underline-offset:4px}
.slot[aria-pressed=true]::after{content:"";position:absolute;left:0;right:0;bottom:-6px;height:6px;background:var(--glaze)}
@keyframes rise{from{transform:translateY(40px) scaleY(.85);opacity:0}}
.detail{display:grid;grid-template-columns:1.3fr 1fr;gap:2rem;padding:2.5rem 0 3.5rem;align-items:start}
.detail h2{font-size:clamp(1.8rem,4vw,2.8rem)}
.detail p{margin:1rem 0 0;max-width:36rem}
dl{margin:0;display:grid;grid-template-columns:auto 1fr;gap:.4rem 1.25rem}
dt{color:var(--muted)}dd{margin:0}
.price{font:700 2rem var(--head);margin:1.25rem 0 1rem}
.add{width:100%;background:var(--glaze);color:var(--on-glaze);border:0;padding:.9rem 1.25rem;font:700 1.05rem var(--head)}
.about{background:var(--surface);padding:3rem 0}
.about .wrap{display:grid;grid-template-columns:1fr 1fr;gap:2.5rem}
.about h2{font-size:clamp(1.6rem,3.5vw,2.3rem)}
.about ol{margin:0;padding-left:1.3rem}.about li{margin:0 0 .8rem}
.about p{margin:1rem 0 0}
footer{padding:2rem 0 3rem;color:var(--muted);font-size:.95rem}
/* keranjang */
.scrim{position:fixed;inset:0;background:rgba(0,0,0,.45);opacity:0;pointer-events:none;transition:opacity .2s}
.drawer{position:fixed;top:0;right:0;bottom:0;width:min(26rem,100%);background:var(--surface);transform:translateX(100%);transition:transform .25s;display:flex;flex-direction:column;padding:calc(1.25rem + env(safe-area-inset-top,0px)) 1.25rem calc(1.25rem + env(safe-area-inset-bottom,0px));overflow-y:auto;border-left:2px solid var(--ink)}
body.open .scrim{opacity:1;pointer-events:auto}body.open .drawer{transform:none}
.dhead{display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem}
.dhead h2{font-size:1.6rem}
.x{background:none;border:2px solid var(--ink);width:2.4rem;height:2.4rem;font-size:1.2rem;line-height:1}
.line{display:grid;grid-template-columns:1fr auto;gap:.2rem .75rem;padding:.8rem 0;border-top:1px solid var(--muted)}
.line strong{font-family:var(--head)}
.qty{display:flex;align-items:center;gap:.5rem}
.qty button{background:none;border:2px solid var(--ink);width:1.9rem;height:1.9rem;line-height:1}
.empty{color:var(--muted)}
.total{display:flex;justify-content:space-between;font:700 1.25rem var(--head);padding:1rem 0;border-top:2px solid var(--ink);margin-top:auto}
form{display:grid;gap:.7rem}
label{font:500 .9rem var(--head)}
input,textarea{width:100%;font:inherit;padding:.6rem .7rem;background:var(--bg);color:var(--ink);border:2px solid var(--ink);border-radius:0}
.hint{font-size:.85rem;color:var(--muted);margin:.3rem 0 0}
@media (max-width:760px){:root{--k:5px}.detail,.about .wrap{grid-template-columns:1fr;gap:1.5rem}}
@media (prefers-reduced-motion:reduce){.slot svg{animation:none}.drawer,.scrim{transition:none}}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <div class="brand">Gerabah Sendang</div>
    <button class="cartbtn" id="openCart" aria-label="Buka keranjang">Keranjang<b id="count">0</b></button>
  </header>

  <section class="intro">
    <h1>Gerabah buatan tangan dari Kasongan, Bantul</h1>
    <p>Dibentuk di putaran, dijemur tiga hari, lalu dibakar di tungku kayu. Setiap barang dikirim dalam peti kayu berisi jerami.</p>
    <div class="filters" role="group" aria-label="Filter menurut fungsi" id="filters"></div>
  </section>

  <p class="shelfnote">Tinggi tiap gerabah di rak sesuai ukuran aslinya. Pilih satu untuk melihat detailnya.</p>
  <div class="shelfscroll"><div class="shelf" id="shelf"></div></div>

  <section class="detail" id="detail" aria-live="polite"></section>
</div>

<section class="about">
  <div class="wrap">
    <div>
      <h2>Cara memesan</h2>
      <ol>
        <li>Masukkan gerabah ke keranjang.</li>
        <li>Isi nama dan alamat, lalu kirim pesanan lewat WhatsApp.</li>
        <li>Kami balas dengan total beserta ongkir dan nomor rekening.</li>
        <li>Setelah pembayaran masuk, barang dikemas dan dikirim dalam 2 hari kerja.</li>
      </ol>
    </div>
    <div>
      <h2>Soal retak dan warna</h2>
      <p>Tanah liat dibakar di suhu sekitar 800 °C, jadi warna dan guratan tiap barang sedikit berbeda dari foto. Itu bukan cacat. Jika barang tiba pecah, kirim foto paketnya dalam 24 jam dan kami ganti.</p>
    </div>
  </div>
</section>

<footer><div class="wrap">Gerabah Sendang, Dusun Kajen, Kasongan, Bantul, Yogyakarta. Buka setiap hari 08.00–16.00.</div></footer>

<div class="scrim" id="scrim"></div>
<aside class="drawer" id="drawer" aria-label="Keranjang" aria-hidden="true">
  <div class="dhead"><h2>Keranjang</h2><button class="x" id="closeCart" aria-label="Tutup keranjang">×</button></div>
  <div id="lines"></div>
  <div class="total"><span>Subtotal</span><span id="sub">Rp0</span></div>
  <form id="order">
    <div><label for="nama">Nama penerima</label><input id="nama" required autocomplete="name"></div>
    <div><label for="alamat">Alamat lengkap dan kota</label><textarea id="alamat" rows="3" required autocomplete="street-address"></textarea></div>
    <button class="add" type="submit">Kirim pesanan lewat WhatsApp</button>
    <p class="hint">Ongkir dihitung setelah alamat kami terima.</p>
  </form>
</aside>

<script>
const WA="6281234567890"; // ganti dengan nomor WhatsApp toko
const P=[
 {id:"kendi",n:"Kendi Jawa",u:"dapur",w:18,h:27,p:85000,c:"--clay",t:"Tanah liat merah, bakar biasa",d:"Kendi untuk menyimpan air minum. Dinding gerabah menguap pelan sehingga airnya tetap sejuk. Cuci dengan air saja.",f:[[.3,0],[.65,.06],[1,.3],[.92,.55],[.5,.68],[.22,.8],[.2,.9],[.34,1]]},
 {id:"cobek",n:"Cobek Bulat",u:"dapur",w:22,h:8,p:55000,c:"--smoke",t:"Tanah liat hitam, diasap",d:"Cobek untuk sambal dan bumbu. Permukaan dalamnya kasar secukupnya sehingga bumbu tidak meluncur. Sebelum dipakai, giling nasi dan garam dulu.",f:[[.5,0],[.9,.3],[1,1]]},
 {id:"pot",n:"Pot Tanam Lurik",u:"taman",w:26,h:30,p:120000,c:"--clay",t:"Tanah liat merah, guratan tangan",d:"Pot dengan lubang drainase dan guratan melingkar. Dindingnya berpori, jadi akar tanaman mudah bernapas.",f:[[.6,0],[.78,.1],[.95,.92],[1,1]]},
 {id:"anglo",n:"Anglo Arang",u:"dapur",w:24,h:24,p:95000,c:"--iron",t:"Tanah liat tahan api",d:"Tungku arang kecil untuk masak sate, jagung, atau menjerang teh. Dapat dipakai langsung di atas api.",f:[[.65,0],[1,.35],[.82,.6],[1,1]]},
 {id:"periuk",n:"Periuk Nasi",u:"dapur",w:24,h:18,p:105000,c:"--smoke",t:"Tanah liat hitam, diasap",d:"Periuk untuk menanak nasi di atas tungku. Nasi matang merata dan beraroma ringan tanah.",f:[[.5,0],[1,.35],[.95,.75],[.7,.9],[.74,1]]},
 {id:"celengan",n:"Celengan Ayam",u:"hias",w:18,h:16,p:35000,c:"--celadon",t:"Glasir celadon",d:"Celengan berbentuk ayam. Untuk mengambil isinya, celengan harus dipecah. Itu memang tujuannya.",f:[[.55,0],[1,.3],[.85,.78],[.3,.92],[.22,1]]},
 {id:"vas",n:"Vas Leher Panjang",u:"hias",w:20,h:40,p:175000,c:"--ash",t:"Glasir abu, bakar dua kali",d:"Vas tinggi untuk ranting kering dan bunga satu tangkai. Glasir abu kayu memberi permukaan halus yang warnanya berubah menurut cahaya.",f:[[.4,0],[.85,.3],[.4,.75],[.3,.95],[.42,1]]},
 {id:"mangkuk",n:"Mangkuk Sayur",u:"dapur",w:16,h:8,p:45000,c:"--celadon",t:"Glasir celadon, aman untuk makanan",d:"Mangkuk dengan glasir di bagian dalam sehingga tidak menyerap kuah. Aman untuk makanan hangat.",f:[[.35,0],[.5,.12],[1,1]]}
];
const U=[["semua","Semua"],["dapur","Dapur"],["taman","Taman"],["hias","Hiasan"]];
const rp=n=>"Rp"+n.toLocaleString("id-ID");
const $=s=>document.getElementById(s);
let filter="semua",sel="kendi",cart={};

function shape(p){
  const W=p.w*10,H=p.h*10,cx=W/2;
  const R=p.f.map(([x,y])=>[cx+x*W/2,H-y*H]);
  const L=R.slice().reverse().map(([x,y])=>[2*cx-x,y]);
  const pts=[...R,...L];
  let d=`M${R[0][0]} ${H}L${pts[0][0]} ${pts[0][1]}`;
  for(let i=0;i<pts.length-1;i++){const a=pts[i],b=pts[i+1];d+=`Q${a[0]} ${a[1]} ${(a[0]+b[0])/2} ${(a[1]+b[1])/2}`}
  d+=`L${L[L.length-1][0]} ${L[L.length-1][1]}L${L[L.length-1][0]} ${H}Z`;
  return `<svg viewBox="0 0 ${W} ${H}" aria-hidden="true"><path d="${d}" fill="var(${p.c})" stroke="var(--ink)" stroke-width="2" vector-effect="non-scaling-stroke"/></svg>`;
}
function drawFilters(){
  $("filters").innerHTML=U.map(([k,l])=>`<button class="chip" data-f="${k}" aria-pressed="${k===filter}">${l}</button>`).join("");
}
function drawShelf(){
  const list=P.filter(p=>filter==="semua"||p.u===filter);
  if(!list.find(p=>p.id===sel))sel=list[0].id;
  $("shelf").innerHTML=list.map((p,i)=>`<button class="slot" data-id="${p.id}" style="--w:${p.w};--h:${p.h};--i:${i}" aria-pressed="${p.id===sel}">${shape(p)}<span>${p.n}</span></button>`).join("");
  drawDetail();
}
function drawDetail(){
  const p=P.find(x=>x.id===sel);
  $("detail").innerHTML=`<div><h2>${p.n}</h2><p>${p.d}</p></div>
  <div><dl><dt>Ukuran</dt><dd>${p.w} × ${p.h} cm</dd><dt>Bahan</dt><dd>${p.t}</dd></dl>
  <div class="price">${rp(p.p)}</div><button class="add" data-add="${p.id}">Masukkan ke keranjang</button></div>`;
}
function drawCart(){
  const ids=Object.keys(cart);
  const n=ids.reduce((s,i)=>s+cart[i],0);
  $("count").textContent=n;
  $("lines").innerHTML=ids.length?ids.map(i=>{const p=P.find(x=>x.id===i);return `<div class="line"><strong>${p.n}</strong><span>${rp(p.p*cart[i])}</span><div class="qty"><button data-q="${i}" data-s="-1" aria-label="Kurangi ${p.n}">−</button><span>${cart[i]}</span><button data-q="${i}" data-s="1" aria-label="Tambah ${p.n}">+</button></div></div>`}).join(""):`<p class="empty">Keranjang masih kosong. Pilih gerabah di rak.</p>`;
  $("sub").textContent=rp(ids.reduce((s,i)=>s+P.find(x=>x.id===i).p*cart[i],0));
  $("order").style.display=ids.length?"grid":"none";
}
function toggle(o){document.body.classList.toggle("open",o);$("drawer").setAttribute("aria-hidden",!o);if(o)$("closeCart").focus()}

document.addEventListener("click",e=>{
  const t=e.target.closest("button");if(!t)return;
  if(t.dataset.f){filter=t.dataset.f;drawFilters();drawShelf()}
  else if(t.dataset.id){sel=t.dataset.id;document.querySelectorAll(".slot").forEach(s=>s.setAttribute("aria-pressed",s===t));drawDetail()}
  else if(t.dataset.add){cart[t.dataset.add]=(cart[t.dataset.add]||0)+1;drawCart();toggle(true)}
  else if(t.dataset.q){const i=t.dataset.q;cart[i]+=+t.dataset.s;if(cart[i]<1)delete cart[i];drawCart()}
  else if(t.id==="openCart")toggle(true);
  else if(t.id==="closeCart")toggle(false);
});
$("scrim").onclick=()=>toggle(false);
document.addEventListener("keydown",e=>{if(e.key==="Escape")toggle(false)});
$("order").onsubmit=e=>{
  e.preventDefault();
  const ids=Object.keys(cart);
  const rows=ids.map(i=>{const p=P.find(x=>x.id===i);return `- ${p.n} × ${cart[i]} = ${rp(p.p*cart[i])}`}).join("\n");
  const msg=`Halo Gerabah Sendang, saya ingin memesan:\n${rows}\n\nSubtotal: ${$("sub").textContent}\nNama: ${$("nama").value}\nAlamat: ${$("alamat").value}\n\nMohon info ongkir dan nomor rekening.`;
  window.open(`https://wa.me/${WA}?text=${encodeURIComponent(msg)}`,"_blank","noopener");
};
drawFilters();drawShelf();drawCart();
</script>
</body>
</html>
